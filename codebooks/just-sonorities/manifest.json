{
 "id": "just-sonorities-demo",
 "version": "1.0.0",
 "title": "Just-intonation sonorities (demo)",
 "demo": true,
 "contributors": [
  {
   "name": "the what3sounds project",
   "role": "wrote this demonstration"
  }
 ],
 "statement": "A demonstration written by Claude for this preview, and nobody's tradition. Twelve whole-number chord shapes are built on each of twelve pitches of a five-limit just scale, in three registers: 432 sonorities, synthesised from their frequency ratios. It is here to show the ratios renderer, and what a small vocabulary costs. With 432 sonorities and three to a place, a place can be no finer than a cell several kilometres across.",
 "terms": {
  "download": true,
  "commercial": true
 },
